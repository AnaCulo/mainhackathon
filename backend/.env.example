APP_ENV=development
BRANE_BASE_URL=https://brane.ai-z.io/api/v1
BRANE_API_KEY=
BRANE_MODEL=openrouter:openai/gpt-6-luna
BRANE_TIMEOUT_SECONDS=30
# Live calls require BRANE_POLICY_SHA256=<SHA-256 of the reviewed tenant GET /policy response>.
BRANE_POLICY_SHA256=
DATABASE_URL=sqlite:///./whistleblower.db
STORAGE_KEY=
BACKEND_API_KEY=
ELEVENLABS_BRIDGE_KEY=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Set to off to hold every report the fixed grammar cannot parse for a person (no model summary).
NARRATIVE_SUMMARIES=on
