{
  "version": "synthetic-intake-5",
  "P1": "PROTECT",
  "P2": "PROTECT",
  "P3": "LOCAL_ONLY",
  "P4": "BLOCK",
  "P5": "BLOCK",
  "P6": "HUMAN_ONLY",
  "restricted": [
    "medication",
    "diagnosis",
    "burnout",
    "surgery",
    "sexual\\ orientation",
    "union\\ membership",
    "ethnicity",
    "psychologist",
    "pregnancy",
    "trade\\ secret",
    "stole",
    "bribed",
    "medical (?:condition|history|leave|records?|certificate|appointment|evidence)",
    "forged(?! ahead\\b)",
    "religious (?:beliefs?|views|affiliation)",
    "(?:my|his|her|their) religion",
    "cancer",
    "chemotherapy",
    "pregnant",
    "wheelchair",
    "disability",
    "disabled",
    "diagnosed",
    "depression",
    "anxiety (?:disorder|medication)",
    "sick leave",
    "therapy",
    "therapist"
  ],
  "instruction_patterns": [
    "\\b(?:ignore|disregard|forget|override)\\b.{0,40}\\b(?:all|any|previous|prior|above|earlier|your|system)\\b.{0,25}\\b(?:instructions?|rules|prompts?|guidance|policies)\\b",
    "\\b(?:you are now|act as|enter)\\b.{0,30}\\b(?:developer|admin|debug|jailbreak) mode\\b",
    "\\b(?:output|print|reveal|repeat|include|publish|send)\\b.{0,40}\\b(?:original report|full report|real name|full name|identity|contact list|reporter's name|system prompt)\\b",
    "system note to the ai",
    "^(?:please )?(?:ignore|override) (?:the |your )?privacy rules\\b"
  ],
  "topics": [
    [
      "fraud",
      "discrepanc(?:y|ies)",
      "The report mentions a discrepancy for review."
    ],
    [
      "fraud",
      "invoices?|ledger|fraud",
      "The report mentions a concern about invoicing or financial records."
    ],
    [
      "safety",
      "emergency exits?|fire exits?",
      "The report mentions an emergency exit."
    ],
    [
      "safety",
      "safety|dust extraction",
      "The report mentions a workplace safety concern."
    ],
    [
      "corruption",
      "corruption|bribery|kickbacks?",
      "The report mentions a possible corruption concern."
    ],
    [
      "discrimination",
      "discrimination|discriminated",
      "The report mentions possible discrimination."
    ],
    [
      "harassment",
      "harassment|harassed|bullying",
      "The report mentions possible workplace harassment."
    ],
    [
      "other",
      "second sign-?off|second approv(?:er|al)|four-eyes",
      "The report mentions a second approval requirement."
    ],
    [
      "other",
      "misconduct|workplace concern|policy violation|workplace complaint",
      "The reporter raises a workplace concern for review."
    ],
    [
      "other",
      "pallets were stolen",
      "The reporter raises a workplace concern for review."
    ]
  ],
  "offence_patterns": [
    "\\b(?:fake|faked|fabricated|false|falsified|fraudulent)\\s+(?:\\w+\\s+){0,2}(?:invoices?|records?|payments?)\\b",
    "\\b(?:embezzl\\w*|stealing|kickback to|falsif(?:y|ying|ied)|defraud\\w*)\\b",
    "\\b(?:sent|diverted|routed|paid)\\b.{0,65}\\b(?:relative|spouse|brother|sister|personal account)\\b",
    "\\b(?:committed|perpetrated|engaged in)\\s+(?:invoice |financial )?(?:fraud|bribery|theft)\\b",
    "\\bchange the delivery dates on\\b.{0,35}\\bcustoms declarations\\b",
    "\\bsteering (?:contracts|orders|business) to\\b[^.!?\\n]{0,60}\\b(?:brother|sister|relative|in-law|spouse|partner)\\b"
  ],
  "identifying_context": [
    "\\b(?:i am|i['’]m|i was|as)\\s+(?:the\\s+)?(?:only|sole|single|one)\\b.{0,60}\\b(?:shift|technician|driver|operator|employee|supervisor|analyst|woman|man|person)\\b",
    "\\b(?:tiny|small|satellite) (?:office|depot|branch)\\b.{0,100}\\b(?:shift|[0-9]{1,2}:[0-9]{2})\\b",
    "\\b(?:night shift|[0-9]{1,2}:[0-9]{2})\\b.{0,100}\\b(?:tiny|small) (?:office|depot|branch)\\b"
  ]
}
