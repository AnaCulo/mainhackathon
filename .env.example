# Presenter: set these on the intake server or in the private file named by DEMO_BACKEND_ENV.
BRANE_BASE_URL=https://brane.ai-z.io/api/v1
BRANE_API_KEY=
BRANE_MODEL=openrouter:openai/gpt-6-luna
# Live calls require BRANE_POLICY_SHA256=<SHA-256 of the reviewed tenant GET /policy response>.
BRANE_POLICY_SHA256=
BRANE_TIMEOUT_SECONDS=30

# Organizer's standalone starter
TEAM_BUILD="Group Čulo / policy-v1"
